{
  "validUsers": [
    {
      "scenario": "standard user",
      "username": "standard_user",
      "password": "secret_sauce",
      "expectedResult": "success"
    },
    {
      "scenario": "problem user (known UI glitches, still logs in)",
      "username": "problem_user",
      "password": "secret_sauce",
      "expectedResult": "success"
    },
    {
      "scenario": "performance-glitch user (slow but logs in)",
      "username": "performance_glitch_user",
      "password": "secret_sauce",
      "expectedResult": "success"
    }
  ],
  "invalidUsers": [
    {
      "scenario": "locked out user",
      "username": "locked_out_user",
      "password": "secret_sauce",
      "expectedResult": "error",
      "expectedMessage": "Sorry, this user has been locked out."
    },
    {
      "scenario": "wrong password",
      "username": "standard_user",
      "password": "wrong_password",
      "expectedResult": "error",
      "expectedMessage": "Username and password do not match any user in this service"
    },
    {
      "scenario": "unregistered username",
      "username": "not_a_real_user",
      "password": "secret_sauce",
      "expectedResult": "error",
      "expectedMessage": "Username and password do not match any user in this service"
    },
    {
      "scenario": "empty username",
      "username": "",
      "password": "secret_sauce",
      "expectedResult": "error",
      "expectedMessage": "Username is required"
    },
    {
      "scenario": "empty password",
      "username": "standard_user",
      "password": "",
      "expectedResult": "error",
      "expectedMessage": "Password is required"
    }
  ]
}
